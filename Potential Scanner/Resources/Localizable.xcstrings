    },
    "battle.affinityWin.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 속성이 %2$@에게 제대로 통했다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s type landed perfectly on %2$@!"
