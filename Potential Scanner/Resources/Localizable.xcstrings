      }
    },
    "comment.027": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈에 나올 확률이 평균보다 높음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above-average odds of showing up in your dreams"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢に出る確率が平均より高い"
          }
        }
      }
    },
    "comment.028": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 것보다 단순 반복에 강한 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better at simple repetition than complex tasks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑なことより単純な反復に強い傾向"
          }
        }
      }
    },
    "comment.029": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까이 있으면 은근히 영향을 받는 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to quietly affect whatever's nearby"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにあると密かに影響を受けると推定"
          }
        }
      }
    },
    "comment.030": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 나서지 않아도 상황이 알아서 풀리는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things tend to work out without it having to step in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自ら動かなくても状況が勝手に片づく傾向"
          }
        }
      }
    },
    "comment.031": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본모습이 하나로 고정되지 않는 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to have no single fixed true form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本来の姿が一つに定まらないと推定"
          }
        }
      }
    },
    "comment.032": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분류 기준 자체를 다시 검토해야 할 수도 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Might require rethinking the classification criteria entirely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類基準そのものを見直す必要があるかもしれない"
