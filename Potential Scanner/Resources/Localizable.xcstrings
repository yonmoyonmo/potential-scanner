    },
    "powerBasis.013": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 수치의 산출 근거는 스캐너도 설명하고 싶어하지 않음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even the scanner would rather not explain how this number came about"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この数値の算出根拠は、スキャナーも説明したがらない"
          }
        }
      }
    },
    "powerBasis.014": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정자의 그날 컨디션이 은근히 반영된 값"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A value that subtly reflects the operator's mood that day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定者のその日のコンディションが密かに反映された値"
          }
        }
      }
    },
    "powerBasis.015": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우주적 우연이 여러 번 겹친 결과로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to be the result of several cosmic coincidences"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宇宙的な偶然が何度も重なった結果と推定"
          }
        }
      }
    },
    "powerBasis.016": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과에 이의가 있다면 재측정을 권장하나 달라지지 않을 확률 높음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you dispute the result, a re-scan is recommended, though it probably won't change"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果に異議があれば再測定を勧めるが、変わらない可能性が高い"
          }
        }
      }
    },
