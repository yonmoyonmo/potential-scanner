        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の属性が %2$@ にしっかり通用した！"
          }
        }
      }
    },
    "battle.affinityWin.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상성 우위! %1$@, %2$@ 상대로 우세했다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type advantage! %1$@ had the edge over %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相性有利！%1$@ が %2$@ 相手に優勢だった。"
          }
        }
      }
    },
    "battle.affinityWin.004": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ 앞에서 기세를 올렸다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ surged with momentum against %2$@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ を前に勢いづいた！"
