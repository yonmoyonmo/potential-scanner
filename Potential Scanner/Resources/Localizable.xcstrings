    },
    "comment.026": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumping into it might hurt you more"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぶつかるとこちらが痛いかもしれない"
