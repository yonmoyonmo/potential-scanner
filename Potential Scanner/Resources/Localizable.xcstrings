        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상보다 오래 버티는 내구도를 지님"
          }
        }
      }
    },
    "comment.022": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes it alone comes out blurry in photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真で本人だけがぼやけて写ることがある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 본인만 흐릿하게 나오는 경우가 있음"
