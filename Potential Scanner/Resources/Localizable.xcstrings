            "value": "%1$@ の勝利で終了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 승리로 종료."
          }
        }
      }
    },
    "battle.victory.004": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ overpowered the opponent!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が相手を制した！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 상대를 제압했다!"
          }
        }
      }
    },
    "battle.victory.005": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The star of this duel is %1$@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
