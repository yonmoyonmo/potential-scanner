    },
    "comment.025": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sturdier than it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目と違って予想より硬い"
          }
        },
        "ko": {
