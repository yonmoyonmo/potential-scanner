        }
      }
    },
    "battle.affinityWin.006": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ 상대로는 천적이나 다름없었다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To %2$@, %1$@ was practically a natural predator!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ にとって %1$@ はまさに天敵だった！"
          }
        }
      }
    },
    "battle.tie.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판정 불가 — 스캐너가 %1$@의 손을 어정쩡하게 들어줬다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too close to call — the scanner awkwardly raised %1$@'s hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判定不能——スキャナーが微妙に %1$@ に軍配を上げた。"
          }
        }
      }
    },
    "battle.tie.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무승부지만 스캐너 기분상 %1$@의 승리로 한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a draw, but the scanner feels like calling it for %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き分けだが、スキャナーの気分で %1$@ の勝ちとする。"
          }
        }
      }
    },
    "battle.tie.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우열을 가릴 수 없어 %1$@ 쪽으로 대충 기울었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clear winner, so it just leaned toward %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優劣がつかず、なんとなく %1$@ に傾いた。"
          }
        }
      }
    },
    "battle.victory.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승자는 %1$@!"
