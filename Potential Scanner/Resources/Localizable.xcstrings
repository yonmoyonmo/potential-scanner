        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 대결의 주인공은 %1$@!"
          }
        }
      }
    },
    "battle.victory.006": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ claimed the win with ease!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が余裕で勝利をものにした！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 여유롭게 승리를 챙겼다!"
          }
        }
      }
    },
    "battle.victory.007": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner's verdict — %1$@ wins by a margin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナー判定——%1$@ の優勢勝ち。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너 판정 결과 — %1$@ 우세승."
          }
        }
      }
    },
    "battle.victory.008": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, %1$@ was a cut above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は %1$@ が一枚上手だった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 오늘은 이쪽이 한 수 위였다."
          }
        }
      }
    },
    "closing.001": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These results have no scientific basis whatsoever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果には一切の科学的根拠がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본 결과는 어떠한 과학적 근거도 없습니다."
          }
        }
      }
    },
    "closing.002": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A re-scan may give different results, and those won't be any more correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再測定すると別の結果が出ることがありますが、それも特に正しいとは言えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재측정 시 다른 결과가 나올 수 있으며, 그것도 딱히 맞다고 볼 수 없습니다."
          }
        }
      }
    },
    "closing.003": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even now, the scanner is doubting its own verdict."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーは今この瞬間も自らの判定を疑っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너는 지금 이 순간에도 자신의 판정을 의심하고 있습니다."
          }
        }
      }
    },
    "closing.004": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No objections to these results will be accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果への異議は受け付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과에 대한 이의제기는 받지 않습니다."
          }
        }
      }
    },
    "comment.001": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widely regarded as the ultimate embodiment of ordinary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆる意味で平凡の極みという評価"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러모로 평범함의 끝판왕이라는 평가"
          }
        }
      }
    },
    "comment.002": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yet secretly wants to be special"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人はむしろ特別になりたがる傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정작 본인은 특별해지고 싶어하는 경향이 있음"
          }
        }
      }
    },
    "comment.003": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May slightly raise the temperature within 1m when awakened"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒時、半径1m以内の温度がわずかに上がることがある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 시 반경 1m 이내 온도가 미세하게 상승할 수 있음"
          }
        }
      }
    },
    "comment.004": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely to insist it's not hot at all"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人は決して熱くないと主張する可能性が高い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 절대 뜨겁지 않다고 주장할 가능성이 높음"
          }
        }
      }
    },
    "comment.005": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to keep changing shape while staying fundamentally the same"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形を変え続けても本質はそのままと推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태를 계속 바꾸면서도 본질은 그대로인 것으로 추정"
          }
        }
      }
    },
    "comment.006": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its impression changes a lot depending on the container it's in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れる器によって印象が大きく変わる傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담기는 그릇에 따라 인상이 크게 달라지는 편"
          }
        }
      }
    },
    "comment.007": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its condition tends to scale with sun exposure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日光を浴びる時間とコンディションが比例する傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "햇빛 노출 시간과 컨디션이 비례하는 경향"
          }
        }
      }
    },
    "comment.008": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to attract static electricity unusually well"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静電気が特につきやすい体質と推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정전기가 유독 잘 붙는 체질로 추정"
          }
        }
      }
    },
    "comment.009": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "78% chance its true personality is the opposite of how it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本体と実際の性格が正反対の確率78%"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본체와 실제 성격이 정반대일 확률 78%"
          }
        }
      }
    },
    "comment.010": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its emotional expressions tend to arrive late"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "感情表現が遅れて届く傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감정 표현이 늦게 도착하는 편"
          }
        }
      }
    },
    "comment.011": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to act before speaking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉より行動が先に出る傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말보다 행동이 먼저 나가는 경향"
          }
        }
      }
    },
    "comment.012": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby specimens tend to tense up around it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くに置くと他の個体が緊張する傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처에 두면 다른 개체가 긴장하는 경향"
          }
        }
      }
    },
    "comment.013": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint vibrations detected when moving (nothing to worry about)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時に微細な振動を検知（気にしなくてよい）"
