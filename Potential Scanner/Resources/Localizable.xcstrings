        }
      }
    },
    "comment.023": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says nothing, yet strangely intimidating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無口なのに妙な威圧感がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말은 없는데 이상하게 위압감이 있음"
