    },
    "comment.060": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 의사와 무관하게 뭔가를 자꾸 끌어들이는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps pulling things in, regardless of its own will"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人の意思とは無関係に何かを引き寄せ続ける傾向"
          }
        }
      }
    },
    "comment.061": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명해서 방심하기 쉬우나 실제론 꽤 위협적"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent enough to underestimate, but actually quite a threat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明で油断しやすいが、実際はかなり脅威的"
          }
        }
      }
    },
    "comment.062": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 평범하다고 생각할 수 있으나 스캐너 판단은 다름"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may think of itself as ordinary, but the scanner disagrees"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人は平凡だと思っているかもしれないが、スキャナーの判断は違う"
          }
        }
      }
    },
    "comment.063": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 조건: 아직 스스로도 인지하지 못한 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
