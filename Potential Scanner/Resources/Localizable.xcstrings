        }
      }
    },
    "comment.021": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has more endurance than expected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予想より長く持ちこたえる耐久力を持つ"
          }
