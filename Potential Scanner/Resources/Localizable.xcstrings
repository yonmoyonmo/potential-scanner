      }
    },
    "comment.027": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above-average odds of showing up in your dreams"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢に出る確率が平均より高い"
