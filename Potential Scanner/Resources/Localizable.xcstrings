          "stringUnit": {
            "state": "translated",
            "value": "꿈에 나올 확률이 평균보다 높음"
          }
        }
      }
    },
    "comment.028": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better at simple repetition than complex tasks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑なことより単純な反復に強い傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 것보다 단순 반복에 강한 편"
          }
        }
      }
    },
    "comment.029": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to quietly affect whatever's nearby"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにあると密かに影響を受けると推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까이 있으면 은근히 영향을 받는 것으로 추정"
          }
        }
      }
    },
    "comment.030": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things tend to work out without it having to step in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自ら動かなくても状況が勝手に片づく傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 나서지 않아도 상황이 알아서 풀리는 편"
          }
        }
      }
    },
    "comment.031": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to have no single fixed true form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本来の姿が一つに定まらないと推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본모습이 하나로 고정되지 않는 것으로 추정"
          }
        }
      }
    },
    "comment.032": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Might require rethinking the classification criteria entirely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類基準そのものを見直す必要があるかもしれない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분류 기준 자체를 다시 검토해야 할 수도 있음"
          }
        }
      }
    },
    "comment.033": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The type whose imagination is its stat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想像力がそのまま能力値になるタイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상상력이 곧 능력치인 유형"
          }
        }
      }
    },
    "comment.034": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed not to understand its own mechanics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人も正確な原理は分かっていないと推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인도 정확한 원리는 모르는 것으로 추정"
          }
        }
      }
    },
    "comment.035": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to draw power from mere existence rather than form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形よりも存在そのものが力の源と推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태보다 존재 자체가 힘의 근원인 것으로 추정"
          }
        }
      }
    },
    "comment.036": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Big gap between its everyday self and its clutch moments"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段と決定的な瞬間の落差が大きい傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소와 결정적인 순간의 낙차가 큰 편"
          }
        }
      }
    },
    "comment.037": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its very existence tends to be treated as a reference point"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在そのものが基準点のように扱われる傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재 자체가 기준점처럼 취급되는 경향"
          }
        }
      }
    },
    "comment.038": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its flexibility to reroute when blocked shows up in the numbers too"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まると回り込む柔軟さが数値にも表れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막히면 돌아가는 유연함이 수치로도 드러남"
          }
        }
      }
    },
    "comment.039": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet usually, then flares up at the decisive moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段は静かで、決定的な瞬間に一気に燃え上がる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소엔 잠잠하다가 결정적 순간에 확 타오름"
          }
        }
      }
    },
    "comment.040": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves traces only where it has passed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通り過ぎた跡にだけ痕跡が残る傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지나간 자리에만 흔적이 남는 편"
          }
        }
      }
    },
    "comment.041": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to get moving, but decisive once it does"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単には動かないが、一度動くと確実"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉽게 안 움직이는데 한번 움직이면 확실함"
          }
        }
      }
    },
    "comment.042": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks laid-back, then settles it in an instant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "のんびりして見えて一瞬で勝負を決める傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느긋해 보이다가 한순간에 승부를 내는 편"
          }
        }
      }
    },
    "comment.043": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Big gap between its gentle impression and the measured values"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかい印象と実測値の間の乖離がかなり大きい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 인상과 실측값 사이 괴리가 상당함"
          }
        }
      }
    },
    "comment.044": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to trace an unpredictable trajectory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測しにくい軌跡を描く傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측하기 어려운 궤적을 그리는 경향"
          }
        }
      }
    },
    "comment.045": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint presence, yet you're in trouble if you lose track of it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在感は薄いが、いざ見失うと困るタイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재감이 흐릿한데 막상 놓치면 곤란한 유형"
          }
        }
      }
    },
    "comment.046": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its condition wobbles when its rhythm breaks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リズムが崩れるとコンディションも一緒に揺らぐ傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리듬이 깨지면 컨디션도 같이 흔들리는 편"
          }
        }
      }
    },
    "comment.047": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured to have a sharpness that misses no small opening"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな隙を見逃さない鋭さが測定された"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 빈틈을 놓치지 않는 예리함이 측정됨"
          }
        }
      }
    },
    "comment.048": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't explain it, but gets results"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明はできなくても結果は出す傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설명은 못 해도 결과는 내는 편"
          }
        }
      }
    },
    "comment.049": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured to be harder to break than it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目と違って簡単には折れないと測定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모습과 달리 쉽게 꺾이지 않는 것으로 측정됨"
          }
        }
      }
    },
    "comment.050": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to call it orthodox, or not — an in-between case"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正統と呼ぶにも否定するにも微妙なケース"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정통이라 부르기도, 아니라 부르기도 애매한 케이스"
          }
        }
      }
    },
    "comment.051": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its readings clearly rise when it's more excited than usual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段より興奮すると測定値が確実に上がる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 흥분했을 때 측정치가 확실히 오름"
          }
        }
      }
    },
    "comment.052": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block it and it just finds a way around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ちふさがるとむしろ迂回路を見つける傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막아서면 오히려 우회로를 찾아내는 편"
          }
        }
      }
    },
    "comment.053": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to leave a mark from just a graze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かすっただけでも痕が残る傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스치기만 해도 흔적이 남는 경향"
          }
        }
      }
    },
    "comment.054": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks slow, but hard to catch at the decisive moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅く見えても決定的な瞬間には追いつきにくい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느린 듯 보여도 결정적 순간엔 따라잡기 힘듦"
          }
        }
      }
    },
    "comment.055": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid foundation, not easily shaken"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基盤が固く、簡単には揺るがない傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기반이 단단해서 쉽게 흔들리지 않는 편"
          }
        }
      }
    },
    "comment.056": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its cold, sharp impression carries straight into the numbers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷たく鋭い印象が数値にもそのまま反映される"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차갑고 날카로운 인상이 수치에도 그대로 반영됨"
          }
        }
      }
    },
    "comment.057": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its influence keeps spreading even while it stays still"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "じっとしていても影響力が広がり続ける傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가만히 있어도 영향력이 계속 뻗어나가는 편"
          }
        }
      }
    },
    "comment.058": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Causes slow but irreversible change"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅いが、取り返しのつかない変化を起こす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리지만 되돌릴 수 없는 변화를 일으킴"
          }
        }
      }
    },
    "comment.059": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A type specialized in momentary impact"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "瞬間的なインパクトに特化したタイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순간적인 임팩트에 특화된 유형"
          }
        }
      }
    },
    "comment.060": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps pulling things in, regardless of its own will"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人の意思とは無関係に何かを引き寄せ続ける傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 의사와 무관하게 뭔가를 자꾸 끌어들이는 편"
          }
        }
      }
    },
    "comment.061": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent enough to underestimate, but actually quite a threat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明で油断しやすいが、実際はかなり脅威的"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명해서 방심하기 쉬우나 실제론 꽤 위협적"
          }
        }
      }
    },
    "comment.062": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may think of itself as ordinary, but the scanner disagrees"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人は平凡だと思っているかもしれないが、スキャナーの判断は違う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 평범하다고 생각할 수 있으나 스캐너 판단은 다름"
          }
        }
      }
    },
    "comment.063": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awakening condition: presumed still unknown even to itself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒条件：本人もまだ自覚していないと推定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 조건: 아직 스스로도 인지하지 못한 것으로 추정"
          }
        }
      }
    },
    "comment.064": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer its potential was suppressed, the bigger the burst on awakening"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "潜在力が抑えられていた期間が長いほど、覚醒時の爆発力が大きい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠재력이 억눌려 있던 기간이 길수록 각성 시 폭발력이 큼"
          }
        }
      }
    },
    "comment.065": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether this is truly its limit hasn't been verified yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の状態が本当の限界かはまだ検証されていない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 상태가 진짜 한계인지는 아직 검증되지 않음"
          }
        }
      }
    },
    "comment.066": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't rule out awakening at an unexpected moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予想外の瞬間に覚醒する可能性は排除できない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상치 못한 순간 각성할 가능성을 배제할 수 없음"
          }
        }
      }
    },
    "comment.067": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Considerable gap between its appearance and its measured values"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目と実測値の乖離がかなり大きい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉보기와 실측 수치 사이의 괴리가 상당함"
          }
        }
      }
    },
    "comment.068": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlikely to respond when called by name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を呼んでも反応しない確率が高い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 부르면 반응할 확률 낮음"
          }
        }
      }
    },
    "comment.069": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtly shifts the mood just by being present."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在するだけで空気をさりげなく変える方"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재만으로 분위기를 은근히 바꿔놓는 편"
          }
        }
      }
    },
    "comment.070": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks vaguely wronged, upon closer inspection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく見ると何となく理不尽な目に遭ってそうに見える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자세히 보면 뭔가 애매하게 억울해 보임"
          }
        }
      }
    },
    "comment.071": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only case the scanner double-checked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーが二度確認した唯一のケース"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 두 번 확인한 유일한 케이스"
          }
        }
      }
    },
    "comment.072": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its presence outweighs its actual weight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重さより存在感の方がずっと重い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게보다 존재감이 훨씬 무거움"
          }
        }
      }
    },
    "comment.073": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stare long enough, and the other party looks away first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長く見つめると相手が先に目をそらす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래 쳐다보면 상대가 먼저 눈을 피함"
          }
        }
      }
    },
    "comment.074": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasn't done much, yet somehow feels trustworthy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に何もしていないのに何故か信頼できる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱히 한 게 없는데 어쩐지 신뢰가 감"
          }
        }
      }
    },
    "comment.075": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feels different every time, even in the same spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ場所にいても毎回違って感じられる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 자리에 있어도 매번 다르게 느껴짐"
          }
        }
      }
    },
    "comment.076": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't fit neatly into any category."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類表のどこにも正確には当てはまらない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분류표 어디에도 정확히 안 들어맞음"
          }
        }
      }
    },
    "comment.077": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer it's left alone, the more valuable it gets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放っておくほど価値が上がるタイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놔두면 놔둘수록 값이 오르는 유형"
          }
        }
      }
    },
    "comment.078": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quietly raises the average of whatever's nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隣にあるものの平均値をさりげなく引き上げる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆에 있는 것들의 평균치를 은근히 끌어올림"
          }
        }
      }
    },
    "comment.079": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even first-timers say it looks oddly familiar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めて見る人も何故か見覚えがあると言う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 보는 사람도 왠지 낯이 익다고 함"
          }
        }
      }
    },
    "comment.080": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Might turn out to be the senior member of this area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実はこのエリアの最古参である可能性がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 보면 이 구역 최고참일 가능성 있음"
          }
        }
      }
    },
    "comment.081": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographs better than it looks in person."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実物より写真映りが良い方"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실물보다 사진발이 좋은 편"
          }
        }
      }
    },
    "comment.082": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives off a 'you'd pick it back up' impression, even if discarded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捨てても拾い直しそうな印象"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버려도 다시 주울 것 같은 인상"
          }
        }
      }
    },
    "comment.083": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to put a price on, so it's just treated with care."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値段をつけにくくて、ただ大事に扱われている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값을 매기기 애매해서 그냥 소중히 다뤄짐"
          }
        }
      }
    },
    "comment.084": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays quiet, then explodes with presence at the crucial moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かにしていて、肝心な時だけ存在感が爆発する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 있다가 결정적일 때만 존재감 폭발"
          }
        }
      }
    },
    "comment.085": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even the scanner struggles to explain how this number came out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーとしてもこの数値が出た理由を説明しづらい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너 입장에서도 왜 이 수치가 나왔는지 설명하기 곤란함"
          }
        }
      }
    },
    "comment.086": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows on you the longer you look."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長く見るほど情が湧くタイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래 볼수록 정이 드는 타입"
          }
        }
      }
    },
    "comment.087": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even the scanner wonders why this got scanned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何故これをスキャンしたのかスキャナーも気になっている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 왜 스캔했는지 스캐너도 궁금해함"
          }
        }
      }
    },
    "comment.088": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only once it's gone does the empty space feel huge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無くなって初めて空いた場所の大きさに気づく"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없어지면 그제서야 빈자리가 크게 느껴짐"
          }
        }
      }
    },
    "comment.089": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seems like it could go unnoticed if stolen, but somehow it never does."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盗まれてもバレなさそうなのに意外とすぐバレる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 훔쳐가도 티가 안 날 것 같은데 의외로 바로 들킴"
          }
        }
      }
    },
    "comment.090": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First impression and re-measurement never match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第一印象と再測定の結果がいつも違う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫인상과 재측정 결과가 항상 다름"
          }
        }
      }
    },
    "comment.091": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quietly becomes the standard within the group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "群れの中でさりげなく基準になる方"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무리 중에서 은근히 기준이 되는 편"
          }
        }
      }
    },
    "comment.092": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leads the conversation without saying much."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に何も言わなくても会話の空気を主導する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 말 안 해도 대화 분위기를 주도함"
          }
        }
      }
    },
    "comment.093": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep looking, and at some point you're attached."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見続けているうちにいつの間にか情が湧いてしまう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 보다 보면 어느 순간 정이 붙어버림"
          }
        }
      }
    },
    "comment.094": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring in a replacement, and you'll still end up back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりを用意しても結局こっちに戻ってくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체품을 갖다 놔도 결국 이쪽으로 돌아오게 됨"
          }
        }
      }
    },
    "comment.095": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets reached for often, and nobody can explain why."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく手が伸びるのに理由は誰も説明できない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손이 자주 가는데 이유는 아무도 설명 못 함"
          }
        }
      }
    },
    "comment.096": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary to everyone else, special only to its 'owner.'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人の目には普通でも持ち主(?)にだけ特別"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남들 눈엔 평범한데 주인(?)한테만 특별함"
          }
        }
      }
    },
    "comment.097": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somehow reassuring to have nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そばに置くと何故か心強い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆에 두면 왠지 든든함"
          }
        }
      }
    },
    "comment.098": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a track record of almost being let go, but never quite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処分しようか悩んで結局手放せなかった前科あり"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없앨까 고민하다가 결국 못 없앤 전적 있음"
          }
        }
      }
    },
    "comment.099": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its mere presence adds negotiating power."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在するだけで交渉力が生まれる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재 자체로 협상력이 생김"
          }
        }
      }
    },
    "comment.100": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weirdly noticeable, no matter where it is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいても不思議と目立つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 묘하게 눈에 띔"
          }
        }
      }
    },
    "comment.101": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old, but carries brand-new energy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いものなのに新品のようなテンションを持つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 물건인데 신상 같은 텐션을 가짐"
          }
        }
      }
    },
    "comment.102": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brand new, yet somehow looks well-worn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新品なのに何故か使い込まれて見える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새것인데 왠지 손때가 묻어 보임"
          }
        }
      }
    },
    "comment.103": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time flies when it's around."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒にいると時間が早く過ぎる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같이 있으면 시간이 빨리 감"
          }
        }
      }
    },
    "comment.104": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rarely gets lost, unlike everything else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やたらと無くなりにくい部類に入る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유독 잘 안 잃어버리는 축에 속함"
          }
        }
      }
    },
    "comment.105": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't seem good at anything in particular, yet irreplaceable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に得意なことはなさそうなのに代わりが利かない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱히 잘하는 게 없어 보이는데 대체가 안 됨"
          }
        }
      }
    },
    "comment.106": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand it off to someone else, and it suddenly feels like a waste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人に譲ろうとすると急に惜しくなる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남한테 넘기려면 괜히 아까워짐"
          }
        }
      }
    },
    "comment.107": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely the first thing you'd think of if lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無くした時に真っ先に思い浮かぶ確率が高い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃어버렸을 때 제일 먼저 떠오를 확률 높음"
          }
        }
      }
    },
    "comment.108": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the same spot yesterday and today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日も今日も同じ場所にいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제도 오늘도 같은 자리에 있음"
          }
        }
      }
    },
    "comment.109": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positioned in a way that would be missed if moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片付けたら寂しがりそうな位置取り"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치우면 서운해할 것 같은 위치 선정"
          }
        }
      }
    },
    "comment.110": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thrives without any upkeep at all."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手入れしなくても勝手にうまくやっている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 안 해도 알아서 잘 지냄"
          }
        }
      }
    },
    "comment.111": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has one big incident on record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけ大きくやらかした前科がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱 한 번 크게 사고 친 전적이 있음"
          }
        }
      }
    },
    "comment.112": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspiciously well-behaved around others."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人の前でだけやたら大人しくなる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남 앞에서만 유독 얌전해짐"
          }
        }
      }
    },
    "comment.113": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even its scratches become a talking point."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傷がついてもむしろ話のネタになる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흠집이 나도 오히려 이야깃거리가 됨"
          }
        }
      }
    },
    "comment.114": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasn't impressive at first, but grew comfortable over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初は微妙だったが使ううちに手に馴染んだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음엔 별로였는데 쓰다 보니 손에 익음"
          }
        }
      }
    },
    "comment.115": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets favored for no particular reason."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に理由もなく偏愛されがち"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이유 없이 편애받는 편"
          }
        }
      }
    },
    "comment.116": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddly easy to spot only when you're in a rush."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急いでいる時だけ不思議とよく目につく"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급할 때만 신기하게 눈에 잘 띔"
          }
        }
      }
    },
    "comment.117": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invisible normally, appears only when searched for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段は見えないのに探す時だけ現れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소엔 안 보이다가 찾을 때만 나타남"
          }
        }
      }
    },
    "comment.118": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one thing that never gets swapped out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんな買い替えてもこれだけは変えない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남들 다 바꿔도 이것만은 안 바꿈"
          }
        }
      }
    },
    "comment.119": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quietly full of nagging energy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地味に小言が多い方"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은근히 잔소리가 많은 편"
          }
        }
      }
    },
    "comment.120": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks fine outside, but nobody knows what's inside."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外見は問題なくても中身は誰も知らない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉은 멀쩡한데 속은 아무도 모름"
          }
        }
      }
    },
    "comment.121": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays quiet, then blindsides you at the worst moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かにしていて肝心な時に裏切ってくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 있다가 결정적 순간에 뒤통수 침"
          }
        }
      }
    },
    "comment.122": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feels oddly weird when someone else touches it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人が触ると何となく変な気分になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남이 만지면 왠지 기분이 묘함"
          }
        }
      }
    },
    "comment.123": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strangely, looks better in person than in photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不思議と写真より実物の方が良い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
