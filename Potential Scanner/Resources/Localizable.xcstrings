      }
    },
    "comment.024": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its shadow tends to register unusually dark"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が特に濃く出る傾向"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 유독 진하게 잡히는 경향"
