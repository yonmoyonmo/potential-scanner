    },
    "battle.victory.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 이번 판을 가져갔다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ took this round!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ がこの勝負を取った！"
          }
        }
      }
    },
    "battle.victory.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 승리로 종료."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It ends in %1$@'s victory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の勝利で終了。"
          }
        }
      }
    },
    "battle.victory.004": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 상대를 제압했다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ overpowered the opponent!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が相手を制した！"
          }
        }
      }
    },
    "battle.victory.005": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 대결의 주인공은 %1$@!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The star of this duel is %1$@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回の対決の主役は %1$@！"
          }
        }
      }
    },
    "battle.victory.006": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 여유롭게 승리를 챙겼다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ claimed the win with ease!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が余裕で勝利をものにした！"
          }
        }
      }
    },
    "battle.victory.007": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너 판정 결과 — %1$@ 우세승."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner's verdict — %1$@ wins by a margin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナー判定——%1$@ の優勢勝ち。"
          }
        }
      }
    },
    "battle.victory.008": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 오늘은 이쪽이 한 수 위였다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, %1$@ was a cut above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は %1$@ が一枚上手だった。"
          }
        }
      }
    },
    "closing.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본 결과는 어떠한 과학적 근거도 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These results have no scientific basis whatsoever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果には一切の科学的根拠がありません。"
          }
        }
      }
    },
    "closing.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재측정 시 다른 결과가 나올 수 있으며, 그것도 딱히 맞다고 볼 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A re-scan may give different results, and those won't be any more correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再測定すると別の結果が出ることがありますが、それも特に正しいとは言えません。"
          }
        }
      }
    },
    "closing.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너는 지금 이 순간에도 자신의 판정을 의심하고 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even now, the scanner is doubting its own verdict."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーは今この瞬間も自らの判定を疑っています。"
          }
        }
      }
    },
    "closing.004": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과에 대한 이의제기는 받지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No objections to these results will be accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果への異議は受け付けません。"
          }
        }
      }
    },
    "comment.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러모로 평범함의 끝판왕이라는 평가"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widely regarded as the ultimate embodiment of ordinary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆる意味で平凡の極みという評価"
          }
        }
      }
    },
    "comment.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정작 본인은 특별해지고 싶어하는 경향이 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yet secretly wants to be special"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人はむしろ特別になりたがる傾向"
          }
        }
      }
    },
    "comment.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 시 반경 1m 이내 온도가 미세하게 상승할 수 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May slightly raise the temperature within 1m when awakened"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒時、半径1m以内の温度がわずかに上がることがある"
          }
        }
      }
    },
    "comment.004": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 절대 뜨겁지 않다고 주장할 가능성이 높음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likely to insist it's not hot at all"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人は決して熱くないと主張する可能性が高い"
          }
        }
      }
    },
    "comment.005": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태를 계속 바꾸면서도 본질은 그대로인 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to keep changing shape while staying fundamentally the same"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形を変え続けても本質はそのままと推定"
          }
        }
      }
    },
    "comment.006": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담기는 그릇에 따라 인상이 크게 달라지는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its impression changes a lot depending on the container it's in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れる器によって印象が大きく変わる傾向"
          }
        }
      }
    },
    "comment.007": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "햇빛 노출 시간과 컨디션이 비례하는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its condition tends to scale with sun exposure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日光を浴びる時間とコンディションが比例する傾向"
          }
        }
      }
    },
    "comment.008": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정전기가 유독 잘 붙는 체질로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to attract static electricity unusually well"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静電気が特につきやすい体質と推定"
          }
        }
      }
    },
    "comment.009": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본체와 실제 성격이 정반대일 확률 78%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "78% chance its true personality is the opposite of how it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本体と実際の性格が正反対の確率78%"
          }
        }
      }
    },
    "comment.010": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감정 표현이 늦게 도착하는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its emotional expressions tend to arrive late"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "感情表現が遅れて届く傾向"
          }
        }
      }
    },
    "comment.011": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말보다 행동이 먼저 나가는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to act before speaking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉より行動が先に出る傾向"
          }
        }
      }
    },
    "comment.012": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처에 두면 다른 개체가 긴장하는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby specimens tend to tense up around it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くに置くと他の個体が緊張する傾向"
          }
        }
      }
    },
    "comment.013": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 시 미세한 진동이 감지됨 (신경 쓰지 않아도 됨)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint vibrations detected when moving (nothing to worry about)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時に微細な振動を検知（気にしなくてよい）"
          }
        }
      }
    },
    "comment.014": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뿌리 내림 본능이 남아있는 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to retain an instinct to put down roots"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "根を張る本能が残っていると推定"
          }
        }
      }
    },
    "comment.015": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재감이 약할수록 전투력이 높아지는 역설적 유형"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paradoxical type: the fainter its presence, the higher its power"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在感が薄いほど戦闘力が上がる逆説的なタイプ"
          }
        }
      }
    },
    "comment.016": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 안 잡히는데 잡히면 꽤 셈"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to pin down, but pretty strong once you do"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捕まえにくいが、捕まえるとかなり強い"
          }
        }
      }
    },
    "comment.017": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정 장비 오류인지 실제 데이터인지 구분 불가"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't tell if it's an equipment error or real data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定機器のエラーか実データか判別不能"
          }
        }
      }
    },
    "comment.018": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재측정 시 결과가 달라질 수 있음 (정상 아님)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results may change on a re-scan (not normal)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再測定で結果が変わることがある（正常ではない）"
          }
        }
      }
    },
    "comment.019": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작아 보여도 무리 지으면 무시 못할 수치가 나옴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks small, but in a group the numbers aren't to be ignored"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく見えても群れると無視できない数値が出る"
          }
        }
      }
    },
    "comment.020": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛 반사가 유독 잘 되는 표면으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to have an unusually reflective surface"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光を特によく反射する表面と推定"
          }
        }
      }
    },
    "comment.021": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상보다 오래 버티는 내구도를 지님"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has more endurance than expected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予想より長く持ちこたえる耐久力を持つ"
          }
        }
      }
    },
    "comment.022": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 본인만 흐릿하게 나오는 경우가 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes it alone comes out blurry in photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真で本人だけがぼやけて写ることがある"
          }
        }
      }
    },
    "comment.023": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말은 없는데 이상하게 위압감이 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says nothing, yet strangely intimidating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無口なのに妙な威圧感がある"
          }
        }
      }
    },
    "comment.024": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 유독 진하게 잡히는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its shadow tends to register unusually dark"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が特に濃く出る傾向"
          }
        }
      }
    },
    "comment.025": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉보기와 다르게 예상보다 단단함"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sturdier than it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目と違って予想より硬い"
          }
        }
      }
    },
    "comment.026": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부딪히면 이쪽이 아플 수 있음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumping into it might hurt you more"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぶつかるとこちらが痛いかもしれない"
