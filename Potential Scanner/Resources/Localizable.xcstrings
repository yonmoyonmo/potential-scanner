    },
    "comment.033": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상상력이 곧 능력치인 유형"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The type whose imagination is its stat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想像力がそのまま能力値になるタイプ"
          }
        }
      }
    },
    "comment.034": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인도 정확한 원리는 모르는 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed not to understand its own mechanics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人も正確な原理は分かっていないと推定"
          }
        }
      }
    },
    "comment.035": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태보다 존재 자체가 힘의 근원인 것으로 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to draw power from mere existence rather than form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形よりも存在そのものが力の源と推定"
          }
        }
      }
    },
    "comment.036": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소와 결정적인 순간의 낙차가 큰 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Big gap between its everyday self and its clutch moments"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段と決定的な瞬間の落差が大きい傾向"
          }
        }
      }
    },
    "comment.037": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재 자체가 기준점처럼 취급되는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its very existence tends to be treated as a reference point"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在そのものが基準点のように扱われる傾向"
          }
        }
      }
    },
    "comment.038": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막히면 돌아가는 유연함이 수치로도 드러남"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its flexibility to reroute when blocked shows up in the numbers too"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まると回り込む柔軟さが数値にも表れる"
          }
        }
      }
    },
    "comment.039": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소엔 잠잠하다가 결정적 순간에 확 타오름"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet usually, then flares up at the decisive moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段は静かで、決定的な瞬間に一気に燃え上がる"
          }
        }
      }
    },
    "comment.040": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지나간 자리에만 흔적이 남는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves traces only where it has passed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通り過ぎた跡にだけ痕跡が残る傾向"
          }
        }
      }
    },
    "comment.041": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉽게 안 움직이는데 한번 움직이면 확실함"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to get moving, but decisive once it does"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単には動かないが、一度動くと確実"
          }
        }
      }
    },
    "comment.042": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느긋해 보이다가 한순간에 승부를 내는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks laid-back, then settles it in an instant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "のんびりして見えて一瞬で勝負を決める傾向"
          }
        }
      }
    },
    "comment.043": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 인상과 실측값 사이 괴리가 상당함"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Big gap between its gentle impression and the measured values"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかい印象と実測値の間の乖離がかなり大きい"
          }
        }
      }
    },
    "comment.044": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측하기 어려운 궤적을 그리는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to trace an unpredictable trajectory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測しにくい軌跡を描く傾向"
          }
        }
      }
    },
    "comment.045": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재감이 흐릿한데 막상 놓치면 곤란한 유형"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint presence, yet you're in trouble if you lose track of it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在感は薄いが、いざ見失うと困るタイプ"
          }
        }
      }
    },
    "comment.046": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리듬이 깨지면 컨디션도 같이 흔들리는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its condition wobbles when its rhythm breaks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リズムが崩れるとコンディションも一緒に揺らぐ傾向"
          }
        }
      }
    },
    "comment.047": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 빈틈을 놓치지 않는 예리함이 측정됨"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured to have a sharpness that misses no small opening"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな隙を見逃さない鋭さが測定された"
          }
        }
      }
    },
    "comment.048": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설명은 못 해도 결과는 내는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't explain it, but gets results"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明はできなくても結果は出す傾向"
          }
        }
      }
    },
    "comment.049": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모습과 달리 쉽게 꺾이지 않는 것으로 측정됨"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured to be harder to break than it looks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目と違って簡単には折れないと測定"
          }
        }
      }
    },
    "comment.050": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정통이라 부르기도, 아니라 부르기도 애매한 케이스"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard to call it orthodox, or not — an in-between case"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正統と呼ぶにも否定するにも微妙なケース"
          }
        }
      }
    },
    "comment.051": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 흥분했을 때 측정치가 확실히 오름"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its readings clearly rise when it's more excited than usual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段より興奮すると測定値が確実に上がる"
          }
        }
      }
    },
    "comment.052": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막아서면 오히려 우회로를 찾아내는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block it and it just finds a way around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ちふさがるとむしろ迂回路を見つける傾向"
          }
        }
      }
    },
    "comment.053": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스치기만 해도 흔적이 남는 경향"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends to leave a mark from just a graze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かすっただけでも痕が残る傾向"
          }
        }
      }
    },
    "comment.054": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느린 듯 보여도 결정적 순간엔 따라잡기 힘듦"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks slow, but hard to catch at the decisive moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅く見えても決定的な瞬間には追いつきにくい"
          }
        }
      }
    },
    "comment.055": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기반이 단단해서 쉽게 흔들리지 않는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid foundation, not easily shaken"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基盤が固く、簡単には揺るがない傾向"
          }
        }
      }
    },
    "comment.056": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차갑고 날카로운 인상이 수치에도 그대로 반영됨"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its cold, sharp impression carries straight into the numbers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷たく鋭い印象が数値にもそのまま反映される"
          }
        }
      }
    },
    "comment.057": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가만히 있어도 영향력이 계속 뻗어나가는 편"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its influence keeps spreading even while it stays still"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "じっとしていても影響力が広がり続ける傾向"
          }
        }
      }
    },
    "comment.058": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리지만 되돌릴 수 없는 변화를 일으킴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Causes slow but irreversible change"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅いが、取り返しのつかない変化を起こす"
          }
        }
      }
    },
    "comment.059": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순간적인 임팩트에 특화된 유형"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
