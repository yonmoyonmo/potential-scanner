        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작아 보여도 무리 지으면 무시 못할 수치가 나옴"
          }
        }
      }
    },
    "comment.020": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to have an unusually reflective surface"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光を特によく反射する表面と推定"
