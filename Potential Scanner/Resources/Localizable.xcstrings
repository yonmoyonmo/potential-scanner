    "powerBasis.010": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not the average of 3 readings, but whichever value seemed most plausible"
          }
        },
        "ja": {
