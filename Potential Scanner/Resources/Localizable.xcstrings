        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 시 미세한 진동이 감지됨 (신경 쓰지 않아도 됨)"
          }
        }
      }
    },
    "comment.014": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presumed to retain an instinct to put down roots"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "根を張る本能が残っていると推定"
          }
