    "⭐️": {},
    "battle.affinityUpset.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 불리한 상성을 전투력으로 뒤집었다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ overturned a bad matchup with raw power!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が不利な相性を戦闘力で覆した！"
          }
        }
      }
    },
    "battle.affinityUpset.002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상성은 %2$@에게 있었으나 %1$@의 힘이 앞섰다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The type edge was %2$@'s, but %1$@'s power won out!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相性は %2$@ にあったが、%1$@ の力が上回った！"
          }
        }
      }
    },
    "battle.affinityUpset.003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 상성 열세를 정면 돌파했다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ powered straight through the type disadvantage!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が相性の不利を正面から突破した！"
          }
        }
      }
    },
    "battle.affinityWin.001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@에게 효과적이었다!"
